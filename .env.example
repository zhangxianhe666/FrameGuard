# 复制为 .env 后填入自己的配置：cp .env.example .env
# .env 已被 .gitignore 忽略，不会被提交到仓库。

# ---------- 必填 ----------
# 多模态模型 API Key。也可以不写在这里，直接在界面「⑥ 模型配置」中填写。
FRAMEGUARD_API_KEY=

# ---------- 选填 ----------
# 模型服务地址（默认值见 core/config.py）
# FRAMEGUARD_BASE_URL=https://chat.intern-ai.org.cn/api/v1/
# FRAMEGUARD_MODEL=InternVL3.5-241B-A28B

# 报告输出目录 / 抽帧缓存目录
# 默认是项目下的 outputs/ 与 cache/；容器化部署时可指向挂载卷
# FRAMEGUARD_OUTPUT_DIR=/data/frameguard/outputs
# FRAMEGUARD_CACHE_DIR=/data/frameguard/cache

# 服务监听地址与端口（默认 127.0.0.1:7891）
# 需要局域网访问时设为 0.0.0.0，并注意自行做好访问控制
# FRAMEGUARD_HOST=127.0.0.1
# FRAMEGUARD_PORT=7891
